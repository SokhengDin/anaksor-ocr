# The OCR API the demo calls (default https://ocr-api.sokhengdin.dev, which only answers
# https://ocr.sokhengdin.dev). Empty: the site's own origin, as with the mock (bun run build:local).
# For a local API: http://localhost:8089, with ALLOWED_ORIGINS=http://localhost:3000 on the API server.
NEXT_PUBLIC_API_URL=https://ocr-api.sokhengdin.dev

# Sub-path the site is served from; empty at the root of the domain.
NEXT_PUBLIC_BASE_PATH=

# Public address of the site, for canonical and hreflang links.
NEXT_PUBLIC_SITE_URL=https://ocr.sokhengdin.dev
