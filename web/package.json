{
  "name": "anaksor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "dev:mock": "NEXT_PUBLIC_API_URL=http://127.0.0.1:8090 bun --bun next dev",
    "mock": "bun scripts/mock-api.mjs",
    "build": "bun --bun next build && bun run standalone:assets",
    "build:local": "NEXT_PUBLIC_API_URL= bun --bun next build && bun run standalone:assets",
    "standalone:assets": "cp -r public .next/standalone/ && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/",
    "start": "PORT=${PORT:-3000} node .next/standalone/server.js",
    "preview": "PORT=8091 HOSTNAME=127.0.0.1 node .next/standalone/server.js & MOCK_UPSTREAM=http://127.0.0.1:8091 bun scripts/mock-api.mjs",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc --noEmit",
    "e2e": "bun e2e/smoke.ts"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "playwright": "1.64.1",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3"
  }
}
